{
  "name": "gh-readme-card",
  "version": "1.0.0",
  "description": "Dynamically generated SVG stats cards for your GitHub profile README",
  "keywords": [
    "readme-cards",
    "svg-cards",
    "profile-readme",
    "github-stats",
    "card-generator"
  ],
  "type": "module",
  "homepage": "https://github.com/h1s97x/gh-readme-card#readme",
  "bugs": {
    "url": "https://github.com/h1s97x/gh-readme-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/h1s97x/gh-readme-card.git"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:update:snapshot": "node --experimental-vm-modules node_modules/jest/bin/jest.js -u",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src tests themes scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "theme-readme-gen": "node scripts/generate-theme-doc",
    "generate-langs-json": "node scripts/generate-langs-json",
    "prepare": "husky"
  },
  "license": "MIT",
  "author": {
    "name": "h1s97x",
    "url": "https://github.com/h1s97x"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.6.4",
    "@types/word-wrap": "^1.2.0",
    "@uppercod/css-to-object": "^1.1.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.5.0",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "dotenv": "^17.2.3",
    "emoji-name-map": "^2.0.3",
    "github-username-regex": "^1.0.0",
    "word-wrap": "^1.2.5"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
